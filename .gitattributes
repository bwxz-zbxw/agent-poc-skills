# 统一行尾，避免跨平台 checkout 把 shell 脚本变成 CRLF（远端 bash 会因 \r 报错）
* text=auto eol=lf

# 部署脚本必须在 Linux 上以 LF 运行
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf

# Windows 安装脚本保持 CRLF（PowerShell 对 LF 也能跑，但保持习惯）
*.ps1   text eol=crlf
*.bat   text eol=crlf

# 二进制 / 归档不参与换行转换
*.png   binary
*.jpg   binary
*.rar   binary
*.xlsx  binary
